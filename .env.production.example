# ============================================
# Cloudflare Pages — Build Environment Variables
# Set these in: Cloudflare Dashboard → Pages → Your Project → Settings → Environment Variables
# ============================================

# Your Railway backend URL (no trailing slash)
# Example: https://omnisport-production.up.railway.app
VITE_API_URL=https://your-app.up.railway.app

# Your Railway WebSocket URL (use wss:// for secure)
# Example: wss://omnisport-production.up.railway.app
VITE_WS_URL=wss://your-app.up.railway.app
