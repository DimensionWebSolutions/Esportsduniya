# ============================================
# OMNISPORT — Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys.
# Get your keys from:
#   RapidAPI:  https://rapidapi.com/api-sports/api/api-sports  (OPTIONAL — AI scores replaces this)
#   OpenAI:    https://platform.openai.com/api-keys
#   Gemini:    https://ai.google.dev/gemini-api/docs/api-key   (REQUIRED for AI-powered live scores)
# ============================================

# ── AI-Powered Live Scores (PRIMARY — uses Gemini + Google Search) ──
# This uses Gemini 2.0 Flash with Google Search grounding to fetch
# real-time sports scores from the internet every 60 seconds.
# Option B: Google Gemini (free tier available)
GEMINI_API_KEY=your gemini api key here
VITE_GEMINI_API_KEY=your gemini api key here

# ── Football-Data.org API (FIFA 2026 live data) ──
# Get your free API key at https://www.football-data.org/client/register
VITE_FOOTBALL_API_KEY=your football-data api key here

# ── Sports Data via RapidAPI (OPTIONAL fallback) ──
# Only needed if AI scores are not working. Sign up at https://rapidapi.com
RAPIDAPI_KEY=your rapidapi api key here

# ── Cricket API (free tier available) ──
# Get a free key at https://cricapi.com — without this, cricket scores use Gemini AI only
CRICAPI_KEY=your_cricapi_key_here

# ── AI Narrative Generation (pick ONE) ──
# Option A: OpenAI
OPENAI_API_KEY=your_openai_key_here

# ── Server ──
PORT=3001

# ── Database (MongoDB Atlas) ──
# Get a free cluster at https://cloud.mongodb.com
# IMPORTANT: include the database name in the path (e.g. /esportsduniya)
# If password has @ # : / ? encode them (e.g. @ → %40)
# Example:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/esportsduniya?retryWrites=true&w=majority&appName=Esportsduniya
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/esportsduniya?retryWrites=true&w=majority

# ── Auth (JWT) ──
# Any long random string — used to sign JWT tokens
JWT_SECRET=change_this_to_a_long_random_secret_string

# ── Web Push (VAPID) — for push notifications ──
# Generate your own VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@esportsduniya.in

# ── Stripe (Premium subscriptions) ──
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
