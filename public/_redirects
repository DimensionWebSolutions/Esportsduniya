# ── Blog: proxy to Render backend so /blog/* are real, Google-indexable URLs ──
/blog https://esportsduniya.onrender.com/blog 200
/blog/* https://esportsduniya.onrender.com/blog/:splat 200
/sitemap-blog.xml https://esportsduniya.onrender.com/sitemap-blog.xml 200

# ── API: proxy to Render backend (fallback if VITE_API_URL missing in build) ──
/api/* https://esportsduniya.onrender.com/api/:splat 200

# ── SPA fallback: all other routes serve index.html ──
/* /index.html 200
